# Producción de SmartPot. El contenido completo va en el secret ENV_FILE; nunca se versiona con valores reales.
# Perfiles: db (MongoDB en el mismo servidor), mail (Mailpit) y simulator (macetas simuladas).
COMPOSE_PROFILES=db,mail

SMARTPOT_BIND_ADDRESS=127.0.0.1
SMARTPOT_API_PORT=8091
SMARTPOT_WEB_PORT=5173
SMARTPOT_MAIL_UI_PORT=8025
SMARTPOT_MQTT_WS_PORT=9001
SMARTPOT_MQTT_TLS_BIND=0.0.0.0
SMARTPOT_MQTT_TLS_PORT=8883
SMARTPOT_CERTS_DIR=/etc/mosquitto/certs

SMARTPOT_DB_TAG=latest
SMARTPOT_CACHE_TAG=latest
SMARTPOT_MAIL_TAG=latest
SMARTPOT_BROKER_TAG=latest
SMARTPOT_AI_TAG=latest
SMARTPOT_API_TAG=latest
SMARTPOT_WEB_TAG=latest
SMARTPOT_SIMULATOR_TAG=latest

MONGO_ROOT_USERNAME=smartpot-root
MONGO_ROOT_PASSWORD=<MONGO_ROOT_PASSWORD>
SMARTPOT_DB_NAME=smartpot
SMARTPOT_DB_USERNAME=smartpot
SMARTPOT_DB_PASSWORD=<MONGO_APP_PASSWORD>
SMARTPOT_SEED_DEMO=false

REDIS_PASSWORD=<REDIS_PASSWORD>

MAIL_USERNAME=smartpot
MAIL_PASSWORD=<SMTP_PASSWORD_MIN_12_CHARS>
MAILPIT_UI_USERNAME=admin
MAILPIT_UI_PASSWORD=<MAILPIT_UI_PASSWORD_MIN_12_CHARS>
MAIL_FROM=SmartPot <no-reply@smartpot.app>

MQTT_ADMIN_USERNAME=smartpot-api
MQTT_ADMIN_PASSWORD=<MQTT_ADMIN_PASSWORD_MIN_16_CHARS>
MQTT_TLS_MAX_CONNECTIONS=200

SMARTPOT_JWT_SECRET=<JWT_SECRET_MIN_32_CHARS>
SMARTPOT_AES_KEY=<BASE64_OF_32_RANDOM_BYTES>
SMARTPOT_AI_TOKEN=<AI_TOKEN_MIN_24_CHARS>
JWT_EXPIRATION=P7D
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
AI_TIMEZONE=America/Bogota

# Macetas virtuales: token entre la API y el simulador (al menos 24 caracteres). Vacío = deshabilitadas.
SIMULATOR_TOKEN=<SIMULATOR_TOKEN_MIN_24_CHARS>

# Telegram (opcional): bot creado con @BotFather. En producción, webhook con secreto (A-Z, a-z, 0-9, _ y -).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=

WEB_BASE_URL=https://smartpot.app
PUBLIC_API_URL=https://api.smartpot.app
CORS_ALLOWED_ORIGINS=https://smartpot.app,https://www.smartpot.app
MQTT_PUBLIC_HOST=mqtt.smartpot.app
MQTT_PUBLIC_PORT=8883
MQTT_PUBLIC_TLS=true
MQTT_WEBSOCKET_URL=wss://mqtt.smartpot.app/mqtt
