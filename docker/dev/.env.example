# Copia este archivo como .env. Son valores de desarrollo: no los uses en producción.
COMPOSE_PROFILES=simulator,mcp

# Carpeta con los repositorios de SmartPot (por defecto, la que contiene a .github)
SMARTPOT_REPOS=../../..

POSTGRES_USER=smartpot-root
POSTGRES_PASSWORD=dev-root-password-123
POSTGRES_DB=smartpot
SMARTPOT_DB_USERNAME=smartpot
SMARTPOT_DB_PASSWORD=dev-app-password-123
SMARTPOT_READER_PASSWORD=dev-reader-password-123
SMARTPOT_SEED_DEMO=true
DATABASE_URL=postgresql://smartpot:dev-app-password-123@db-smartpot:5432/smartpot?sslmode=disable

VALKEY_PASSWORD=dev-redis-password-123
CACHE_PASSWORD=dev-redis-password-123
VALKEY_SOCKET=/var/run/smartpot/valkey.sock

MAIL_USERNAME=smartpot
MAIL_PASSWORD=dev-mail-password
MAILPIT_UI_USERNAME=admin
MAILPIT_UI_PASSWORD=dev-mailpit-ui

MQTT_ADMIN_USERNAME=smartpot-api
MQTT_ADMIN_PASSWORD=dev-mqtt-admin-password
MQTT_AUTHN_TOKEN=dev-broker-authn-token-123456
MQTT_AUTHN_URL=http://api-smartpot:8091/internal/mqtt/authn
MQTT_BROKER_API_KEY=dev-broker-api-key
MQTT_BROKER_API_SECRET=dev-broker-api-secret-123456

SMARTPOT_JWT_SECRET=dev-jwt-secret-for-local-use-only-0123456789
SMARTPOT_AES_KEY=ZGVtby1vbmx5LXNtYXJ0cG90LWFlcy1rZXktMzJieXQ=
SMARTPOT_AI_TOKEN=dev-ai-token-for-local-use-only
AI_GRPC_SOCKET=/var/run/smartpot/ai.sock

SMARTPOT_TRAINER_TOKEN=dev-ai-token-for-local-use-only
SMARTPOT_TRAINER_URL=http://trainer-smartpot:8001

SIMULATOR_TOKEN=dev-simulator-token-for-local-use

# Opcional: tu bot de @BotFather para probar las alertas por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling

# Macetas simuladas de los datos demo (cropId:clave:TIPO)
SIMULATOR_DEVICES=66f5a1000000000000000101:demo-lettuce-device-key-2026:LETTUCE,66f5a1000000000000000102:demo-tomato-device-key-2026:TOMATO
