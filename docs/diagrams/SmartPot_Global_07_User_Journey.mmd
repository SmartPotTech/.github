%%{init: {"theme": "base", "fontFamily": "Segoe UI, Arial, sans-serif", "themeVariables": {"fontFamily": "Segoe UI, Arial, sans-serif", "fontSize": "16px", "primaryColor": "#DDF5EA", "primaryTextColor": "#17261F", "primaryBorderColor": "#067A52", "secondaryColor": "#E3F2FB", "secondaryTextColor": "#17261F", "secondaryBorderColor": "#1F6FA0", "tertiaryColor": "#F2F7F4", "tertiaryTextColor": "#17261F", "tertiaryBorderColor": "#D5E3DC", "lineColor": "#5B6B63", "textColor": "#17261F", "mainBkg": "#DDF5EA", "nodeBorder": "#067A52", "clusterBkg": "#F7FAF8", "clusterBorder": "#D5E3DC", "edgeLabelBackground": "#FFFFFF", "actorBkg": "#067A52", "actorBorder": "#0B3D2B", "actorTextColor": "#FFFFFF", "actorLineColor": "#5B6B63", "signalColor": "#17261F", "signalTextColor": "#17261F", "labelBoxBkgColor": "#0B3D2B", "labelBoxBorderColor": "#0B3D2B", "labelTextColor": "#FFFFFF", "loopTextColor": "#0B3D2B", "noteBkgColor": "#FDF4DD", "noteBorderColor": "#C98D12", "noteTextColor": "#17261F", "activationBkgColor": "#DDF5EA", "activationBorderColor": "#067A52", "attributeBackgroundColorOdd": "#FFFFFF", "attributeBackgroundColorEven": "#F2F7F4"}, "layout": "elk", "elk": {"nodePlacementStrategy": "BRANDES_KOEPF", "mergeEdges": false, "cycleBreakingStrategy": "GREEDY"}, "flowchart": {"useMaxWidth": false, "htmlLabels": true, "curve": "basis", "padding": 14, "nodeSpacing": 45, "rankSpacing": 80, "wrappingWidth": 360}}}%%
flowchart LR
  visitor(["Visitante"])
  owner(["Crop Owner / Grower"])

  subgraph public["Páginas públicas"]
    direction TB
    landing["/ · Inicio<br/>funciones · especies · preguntas frecuentes<br/>Open Graph · JSON-LD · sitemap"]
    login["/login · Mantener sesión iniciada"]
    register["/register"]
    forgot["/forgot-password"]
    reset["/reset-password?token="]
  end

  subgraph app["/app · requiere sesión · navegación lateral o inferior"]
    direction TB
    overview["/app · Overview Dashboard<br/>average health · online devices · commands executed today<br/>ranking · AI analysis · fleet comparator · latest readings"]
    crops["/app/crops · My Crops<br/>tarjetas real o virtual · forma<br/>Nuevo crop: tipo fijo · especie · forma · lugar<br/>preview · ESP32 or Wokwi guide"]
    control["/app/control · Fleet Control<br/>auto per-crop or fleet-wide · shortcuts · bulk commands"]
    actions["/app/actions · Actions<br/>bulk recommendations · command history"]
    learningp["/app/learning · Learning (escritorio)<br/>quality · models · states · anomalies"]
    alerts["/app/notifications · Notifications"]
    profile["/app/profile · Perfil<br/>profile data · password · applications<br/>Telegram disabled if unconfigured · Account Deletion"]
    subgraph detail["/app/crops/:cropId · Detalle del crop"]
      direction TB
      summary["Summary<br/>readings vs threshold · 24h timeline"]
      assistant["AI Assistant<br/>health index derivation · placement recommendation<br/>diagnosis · forecast · insights · actions"]
      ctrl["Control<br/>automatic mode · one switch per actuator<br/>with duration · commands"]
      history["History<br/>6h · 24h · 7d · CSV export"]
      hero["Ilustración del crop · sobre todas las secciones<br/>form and species in environment · each actuator<br/>encendido o apagado · weather de afuera · sin acciones"]
      virtualtab["Simulación · solo virtuales<br/>estado con Pausar y Reanudar<br/>simulation controls · mode · meters · apply changes"]
      settings["Settings<br/>data · location (environment, sun, coordinates)<br/>Telegram alerts if chat is linked"]
      devicetab["Dispositivo · solo reales<br/>ESP32 or Wokwi guide · config.py with CA · key rotation"]
    end
  end

  subgraph endpoints["API /api/v1"]
    direction TB
    eauth["POST auth/register · auth/login<br/>auth/password/forgot · auth/password/reset"]
    eprofiles["GET crop-profiles (public)"]
    eusers["GET PUT DELETE users/me · PUT users/me/password"]
    ecrops["GET POST crops · GET PUT DELETE crops/{id}<br/>PUT crops/{id}/automation · PUT crops/automation<br/>GET crops/{id}/weather"]
    edevice["GET crops/{id}/device · POST crops/{id}/device/key"]
    ereadings["GET POST crops/{id}/readings<br/>latest · summary · export"]
    eactuators["GET POST DELETE crops/{id}/actuators"]
    ecommands["GET POST crops/{id}/commands<br/>GET commands · POST commands/bulk"]
    einsights["GET crops/{id}/insights"]
    eoverview["GET overview · overview/series · overview/fleet"]
    enotif["GET notifications · unread-count<br/>PUT {id}/read · read-all · DELETE {id}"]
    echannels["GET channels · POST channels/telegram/link<br/>PUT DELETE channels/links/{id} · POST links/{id}/test<br/>GET PUT crops/{id}/channels · POST DELETE recipients"]
    evirtual["GET PUT DELETE crops/{id}/virtual-device<br/>GET virtual-devices/places"]
    elearning["GET ai/learning"]
  end

  subgraph backend["Servicios que responden"]
    direction TB
    sauth["AuthService · MailService"]
    scrop["CropService · DeviceProvisioner"]
    sread["ReadingService"]
    scmd["CommandService · broker MQTT"]
    sinsight["InsightService → IA /v1/insights"]
    sover["OverviewService → IA /v1/fleet"]
    snotif["NotificationService"]
    schan["ChannelService · Telegram"]
    svirt["VirtualDeviceService → simulador"]
    slearn["AiClient → IA /v1/learning/status"]
  end

  visitor --> landing --> login & register
  login --> forgot --> reset
  owner --> login
  login & register -->|"JWT"| overview
  overview --> crops --> detail
  overview --> control & actions & learningp & alerts & profile

  login & register & forgot & reset --> eauth
  landing --> eprofiles
  crops --> ecrops
  crops --> eprofiles
  summary --> ereadings
  assistant --> einsights
  assistant --> ecommands
  ctrl --> ecrops & eactuators & ecommands
  history --> ereadings
  devicetab --> edevice
  hero --> eactuators & ecommands & evirtual & ecrops
  settings --> ecrops & echannels
  virtualtab --> evirtual
  overview --> eoverview
  control --> ecrops & ecommands
  actions --> eoverview & ecommands
  learningp --> elearning
  alerts --> enotif
  profile --> eusers & echannels

  eauth --> sauth
  eusers --> sauth
  ecrops & edevice --> scrop
  ereadings --> sread
  eactuators & ecommands --> scmd
  einsights --> sinsight
  eoverview --> sover
  enotif --> snotif
  echannels --> schan
  evirtual --> svirt
  elearning --> slearn
  eprofiles --> slearn

  classDef person fill:#067A52,stroke:#0B3D2B,color:#FFFFFF
  classDef device fill:#FBE9E1,stroke:#B85A38,color:#17261F
  classDef edge fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef web fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef core fill:#0B3D2B,stroke:#06281C,color:#FFFFFF
  classDef module fill:#FFFFFF,stroke:#067A52,color:#17261F
  classDef ai fill:#EEF7FC,stroke:#1F6FA0,color:#17261F
  classDef store fill:#F2F7F4,stroke:#5B6B63,color:#17261F
  classDef ext fill:#FDF4DD,stroke:#C98D12,color:#17261F
  classDef warn fill:#FBE3E3,stroke:#D64545,color:#17261F
  classDef note fill:#FFFFFF,stroke:#D5E3DC,color:#5B6B63
  class visitor,owner person
  class landing,login,register,forgot,reset web
  class overview,crops,control,actions,learningp,alerts,profile,summary,assistant,ctrl,history,devicetab,virtualtab,hero,settings web
  class eauth,eprofiles,eusers,ecrops,edevice,ereadings,eactuators,ecommands,einsights,eoverview,enotif,echannels,evirtual,elearning edge
  class sauth,scrop,sread,scmd,sinsight,sover,snotif,schan,svirt,slearn module
