stateDiagram-v2
  direction LR

  state "User Session" as user_session {
    direction LR
    [*] --> Anonima
    Anonymous --> Authenticated : Login or Register (HttpOnly Cookie)
    Authenticated --> Anonymous : Sign out (CSRF verified) or session expired
    Anonymous --> Recovering : Forgot password request
    Recovering --> Anonymous : Token expired (30m)
    Recovering --> Authenticated : Password updated & authenticated
    Anonymous --> RateLimited : >10 requests/min to /auth (Valkey SET NX)
    RateLimited --> Anonymous : 1 minute window elapsed (429 Retry-After)
  }

  state "Device and MQTT Tenant Account" as device_account {
    direction LR
    [*] --> Provisioned : Create crop (AES-GCM key generated)
    Provisioned --> Online : CONNECT with key · status online
    Online --> Disconnected : LWT message published (offline)
    Disconnected --> Online : Reconnected with valid key
    Online --> Rotated : Key rotated via API (evict sessions)
    Rotated --> Online : Reconnected with new key
    Provisioned --> Retired : Delete crop & revoke credentials
    Desconectada --> Retirada : borrar el crop
    Retirada --> [*]
  }

  state "Comando" as comando {
    direction LR
    [*] --> PENDING : User or autonomous agent command
    PENDING --> SENT : Published with QoS 1 to broker
    PENDING --> FAILED : broker no disponible
    SENT --> EXECUTED : ACK EXECUTED
    SENT --> FAILED : ACK FAILED
    SENT --> EXPIRED : sin ACK en 2 min
    EXECUTED --> [*]
    FAILED --> [*] : Alerts owner
    EXPIRED --> [*] : Alerts owner
  }

  state "Actuator Switch" as switch {
    direction LR
    state "Off (OFF)" as SwitchOff
    state "Timed Actuator Operation" as SwitchTimed
    state "Indefinite On" as SwitchUnlimited
    [*] --> SwitchOff
    SwitchOff --> SwitchTimed : Turn on with duration, al confirmsr
    SwitchOff --> SwitchUnlimited : encender sin límite, al confirmsr
    SwitchTimed --> SwitchOff : Turn off o vence runningUntil
    SwitchTimed --> SwitchUnlimited : encender sin límite
    SwitchUnlimited --> SwitchTimed : Turn on with duration
    SwitchUnlimited --> SwitchOff : Turn off, al confirmsr
  }

  state "Crop Evaluation" as salud {
    direction LR
    [*] --> SinLecturas
    NoReadings --> Evaluated : First valid reading
    state Evaluado {
      direction LR
      EXCELLENT --> GOOD : baja el índice
      GOOD --> FAIR
      FAIR --> POOR
      POOR --> CRITICAL
      CRITICAL --> POOR : se corrige
      POOR --> FAIR
      FAIR --> GOOD
      GOOD --> EXCELLENT
    }
    Evaluado --> Bloqueado : posible falla de sensor
    Blocked --> Evaluated : Consistent readings restored
  }

  state "Automatic Mode" as automatico {
    direction LR
    [*] --> Sugerencias
    Sugerencias --> Automatic : User activates (single or bulk crops)
    Automatico --> Sugerencias : la persona lo desactiva
    state Automatico {
      direction LR
      Libre --> Enfriando : el agente actúa sobre un actuador
      Enfriando --> Libre : pasan 10 minutos
    }
  }

  state "Species-Specific Learning" as aprendizaje {
    direction LR
    [*] --> JuntandoDatos
    JuntandoDatos --> Entrenando : 200 lecturas etiquetadas
    Entrenando --> AlDia : el retador supera a la baseline y al campeón
    Entrenando --> Pendiente : faltan casos positivos
    Entrenando --> AlDia : se conserva el campeón
    AlDia --> Entrenando : 300 lecturas nuevas
    Pendiente --> Entrenando : 300 lecturas nuevas
    AlDia --> Reentrenar : cambia la versión de scikit-learn
    Reentrenar --> Entrenando
  }

  state "Telegram Link" as telegram {
    direction LR
    [*] --> CodeIssued : Request Code (10 min)
    CodigoEmitido --> [*] : vence sin usarse
    CodigoEmitido --> Activo : /start código en un chat privado
    Activo --> Desactivado : la persona lo apaga
    Desactivado --> Activo : la persona lo enciende
    Activo --> Pausado : chat bloqueado o 5 fallos seguidos
    Pausado --> Activo : la persona lo reactiva
    Activo --> [*] : /desvincular o desde la PWA
  }

  state "Virtual Crop Simulation" as virtual {
    direction LR
    [*] --> Encendida : crear el crop con kind VIRTUAL
    EnPausa --> Encendida : PUT virtual-device (reanuda · la API la recrea si falta)
    state Encendida {
      direction LR
      AUTO --> MANUAL : la persona cambia el modo
      MANUAL --> WEATHER
      WEATHER --> AUTO
    }
    Encendida --> Paused : DELETE virtual-device (pauses and preserves configuration)
    Encendida --> [*] : borrar el crop
  }
