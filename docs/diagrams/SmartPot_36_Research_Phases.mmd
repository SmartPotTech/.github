flowchart LR
  subgraph propuesta["Research Proposal · 12 Months"]
    direction TB
    f1["<b>Phase 1 · Baseline</b><br/>Agronomic Parameters for Lettuce<br/>and Hydraulic Rig"]
    f2["<b>Phase 2 · IoT & Integration</b><br/>ESP32 Firmware, Protocol<br/>and Actuation Testing"]
    f3["<b>Phase 3 · Data & AI</b><br/>Growth Cycle 1 for Data Acquisition<br/>and Model Training"]
    f4["<b>Phase 4 · Validation</b><br/>Growth Cycle 2: SmartPot vs.<br/>Manual Control & Statistical Analysis"]
    f1 --> f2 --> f3 --> f4
  end
  subgraph hoy["State as of Late 2026"]
    direction TB
    h1["<b>Phase 1 · Partial</b><br/>Knowledge Base for 6 Species;<br/>No Dedicated Hydraulic Rig"]
    h2["<b>Phase 2 · Fulfilled in Software</b><br/>MQTT Firmware Tested in Wokwi<br/>and Virtual Crops"]
